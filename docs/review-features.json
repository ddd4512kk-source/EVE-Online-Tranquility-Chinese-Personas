{
  "combat": {
    "kinds": [
      "person"
    ],
    "implementation": [
      "scripts/person-identity.mjs",
      "scripts/person-document.mjs",
      "scripts/battles.mjs",
      "scripts/battle-report.mjs",
      "scripts/battle-archive.mjs"
    ],
    "pattern": "指挥|带队|舰队|参战|战役|战场|战斗|泰坦|超旗|会战|旗舰|击杀|战绩|[Kk][Bb]|[Mm]onitor|监视者|FLEET\\s+COMMANDER",
    "rules": [
      {
        "file": "docs/research-method.md",
        "heading": "### 1. 游戏画像（定位人物时按需）"
      },
      {
        "file": "docs/writing-review.md",
        "heading": "## zKB与战役写点评，不写账本"
      },
      {
        "file": "docs/writing-review.md",
        "contains": "**新收录先验调查覆盖，再验文字**"
      },
      {
        "file": "docs/writing-review.md",
        "contains": "标签表示活动圈子"
      }
    ],
    "checks": {
      "profile": "收录号综合KB、常用船及实际职责",
      "alts": "主力小号与售号归因边界",
      "peaks": "高值月份与代表KM的采用或略过理由",
      "battles": "已有战役对照、窗口与本人角色",
      "narrative": "调查发现进入正文的具体位置与综合点评"
    }
  },
  "battle-attribution": {
    "kinds": [
      "battle"
    ],
    "implementation": [
      "scripts/battles.mjs",
      "scripts/battle-report.mjs",
      "scripts/battle-archive.mjs"
    ],
    "pattern": "指挥|参战|华人|军团|联盟|阵营",
    "rules": [
      {
        "file": "docs/battle-template.md"
      }
    ]
  },
  "battle-videos": {
    "kinds": [
      "battle"
    ],
    "implementation": [
      "scripts/bilibili-archive.mjs"
    ],
    "pattern": "视频|视角|BV[0-9A-Za-z]+|BR|战报",
    "rules": [
      {
        "file": "docs/content-rules.md",
        "contains": "**相关视频**"
      },
      {
        "file": "docs/research-method.md",
        "contains": "**战役视频候选**"
      },
      {
        "file": "docs/research-method.md",
        "contains": "**战役视频关联**"
      },
      {
        "file": "docs/research-method.md",
        "contains": "**简介战报入口**"
      },
      {
        "file": "docs/research-method.md",
        "contains": "**B站日期与中文时段**"
      },
      {
        "file": "docs/battle-template.md",
        "heading": "## 相关视频填写"
      }
    ]
  },
  "persona-tags": {
    "kinds": [
      "person"
    ],
    "implementation": [
      "scripts/corporation-tags.mjs"
    ],
    "pattern": "总监|教官|招新|RMT|脚本|诈骗|内讧|决裂|弹劾",
    "rules": [
      {
        "file": "docs/writing-review.md",
        "heading": "## 标签"
      }
    ]
  },
  "famous-fc": {
    "kinds": [
      "person"
    ],
    "implementation": [
      "scripts/battles.mjs",
      "scripts/person-identity.mjs",
      "scripts/battle-archive.mjs"
    ],
    "pattern": "著名FC|FC|指挥|带队",
    "rules": [
      {
        "file": "docs/writing-review.md",
        "contains": "标签表示活动圈子"
      }
    ]
  },
  "writing-depth": {
    "kinds": [
      "person"
    ],
    "eventReview": true,
    "implementation": [
      "scripts/review.mjs"
    ],
    "pattern": "封号|封禁|永封|RMT|诈骗|骗钱|卷款|脚本|内讧|决裂|出走|弹劾|丑闻|背刺|清算",
    "rules": [
      {
        "file": "docs/writing-review.md",
        "heading": "## 发挥边界"
      },
      {
        "file": "docs/writing-review.md",
        "heading": "## 发挥要显著"
      },
      {
        "file": "docs/writing-review.md",
        "heading": "## 重料的分量与发挥验收"
      },
      {
        "file": "docs/writing-review.md",
        "heading": "## 黑料过多时合并与取舍"
      }
    ],
    "checks": {
      "coverage": "对照完整正文与已有素材，清点独立事件及未采用重料",
      "events": "逐件判分量、采用方式、发挥方向与充分程度",
      "balance": "检查重料在全文中的叙事分量、主线与评语"
    }
  }
}
