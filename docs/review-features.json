{
  "combat": {
    "kinds": [
      "person"
    ],
    "implementation": [
      "scripts/person-identity.mjs",
      "scripts/person-document.mjs",
      "scripts/battles.mjs",
      "scripts/battle-report.mjs",
      "scripts/battle-archive.mjs"
    ],
    "pattern": "指挥|带队|舰队|参战|战役|战场|战斗|泰坦|超旗|会战|旗舰|击杀|战绩|[Kk][Bb]|[Mm]onitor|监视者|FLEET\\s+COMMANDER",
    "rules": [
      {
        "file": "docs/research-method.md",
        "heading": "### 1. 游戏画像（定位人物时按需）"
      },
      {
        "file": "docs/writing-review.md",
        "heading": "## zKB与战役写点评，不写账本"
      },
      {
        "file": "docs/writing-review.md",
        "contains": "**新收录先验调查覆盖，再验文字**"
      },
      {
        "file": "docs/writing-review.md",
        "contains": "标签表示活动圈子"
      },
      {
        "file": "docs/content-rules.md",
        "contains": "**战绩红料写总结性点评**"
      }
    ],
    "checks": {
      "profile": "以stats总览判断战斗频率、规模及正文相符程度；职责证据按需核",
      "alts": "已确认主力小号的stats总览及同人、售号归因边界，不逐号补全船型细目",
      "peaks": "是否有须细查月份或代表KM的具体事件、职责或战果问题；无此需要可不适用",
      "battles": "已有战役对照、窗口与本人角色",
      "narrative": "独立战绩红料块的正文位置与综合点评；有显著战斗经历而战绩散在开篇或其他料块，不能标为 reviewed"
    },
    "strictness": {
      "level": 1,
      "rules": "c03a2081f43938c7010a34258366f5e714cb3e7322367c143857f7991d54000b"
    }
  },
