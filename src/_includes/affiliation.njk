{#- 显示军团与联盟。传入 char（角色缓存数据）；affCompact 为目录卡片用，只写军团缩写，联盟交给卡片底图。 -#}
{%- set aff = char.affiliation -%}
{%- if aff and affCompact -%}
<span class="aff"><span class="aff-corp" title="{{ aff.corporation.name }}{% if aff.alliance %} · {{ aff.alliance.name }}{% endif %}">{% if aff.corporation.ticker %}<span class="ticker">{{ aff.corporation.ticker }}</span>{% else %}{{ aff.corporation.name }}{% endif %}</span>
  {%- if aff.left_at %} <span class="aff-left" title="{{ aff.left_at | ym }} 离开">（已离开）</span>{% endif %}</span>
{%- elif aff -%}
<span class="aff">
  {#- aff-main 收军团名与缩写 -#}
  <span class="aff-main"><span class="aff-corp"><span class="aff-corp-name" title="{{ aff.corporation.name }}">{% if affLink %}<a href="https://evewho.com/corporation/{{ aff.corporation.id }}" target="_blank" rel="noopener noreferrer">{{ aff.corporation.name }}</a>{% else %}{{ aff.corporation.name }}{% endif %}</span></span> <span class="aff-tickers">{% if aff.corporation.ticker %}<span class="ticker">[{{ aff.corporation.ticker }}]</span>{% endif %}
  {#- 联盟写全名加缩写 -#}
  {%- if aff.alliance %}<span class="aff-sep"> · </span><span class="aff-ally">
    {%- if affLink %}<a href="https://evewho.com/alliance/{{ aff.alliance.id }}" target="_blank" rel="noopener noreferrer">{{ aff.alliance.name }}</a>{% else %}{{ aff.alliance.name }}{% endif -%}
    {%- if aff.alliance.ticker %} <span class="ticker">&lt;{{ aff.alliance.ticker }}&gt;</span>{% endif -%}
  </span>{% endif %}</span></span>
  {%- if aff.left_at %} <span class="aff-left">（{{ aff.left_at | ym }} 离开）</span>{% endif %}
</span>
{%- else -%}
<span class="aff aff-none">从未加入玩家军团</span>
{%- endif -%}
{%- if char.current_corporation.id == 1000001 %} <span class="aff-deleted">已删号</span>{% endif -%}
