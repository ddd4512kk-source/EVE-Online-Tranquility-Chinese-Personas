<!doctype html>
<html lang="{{ site.lang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if pageTitle %}{{ pageTitle }} · {% endif %}{{ site.title }}</title>
  <meta name="description" content="{{ pageDescription or site.description }}">
  <meta name="color-scheme" content="dark light">
  <script>try{var t=localStorage.getItem('theme');if(t==='light'||t==='dark')document.documentElement.dataset.theme=t}catch(e){}</script>
  <link rel="stylesheet" href="{{ '/assets/css/fonts.css' | url }}?v={{ site.build }}">
  <link rel="stylesheet" href="{{ '/assets/css/site.css' | url }}?v={{ site.build }}">
  <link rel="icon" href="{{ '/assets/favicon.svg' | url }}" type="image/svg+xml">
  {% block head %}{% endblock %}
</head>
<body class="{{ bodyClass }}">
  <header class="site-header">
    <div class="wrap header-inner">
      <a class="brand" href="{{ '/' | url }}">
        <span class="brand-seal" aria-hidden="true">{{ site.seal }}</span>
        <span class="brand-text">{{ site.title }}<small>{{ site.subtitle }}</small></span>
      </a>
      <img class="hits" id="hits" data-src="{{ site.hits }}" alt="点击人次" referrerpolicy="no-referrer" decoding="async" hidden>
      <nav class="site-nav" aria-label="主导航">
        {%- for s in sections %}{% if collections[s.collection].length %}
        <a href="{{ s.url | url }}">{{ s.name }}</a>
        {%- endif %}{% endfor %}
        <a href="{{ '/search/' | url }}">搜索</a>
        <a href="{{ '/random/' | url }}" class="nav-random" title="随机翻开一篇">梦中情人</a>
        <button type="button" class="theme-toggle" id="theme-toggle" title="切换深浅色" aria-label="切换深浅色" hidden>
          <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg>
        </button>
      </nav>
    </div>
  </header>

  <main class="wrap" id="main">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="wrap">
      <p>本站为玩家社区创作，所写皆为游戏内外轶事与评论，博君一笑，请勿当真。角色数据为抓取时快照，来自 <a href="https://evewho.com" rel="noopener">EveWho</a> 与 CCP ESI。</p>
      <p><a href="{{ '/glossary/' | url }}">术语表</a> · <a href="{{ site.repo }}" rel="noopener">GitHub 仓库</a> · <a href="https://docs.qq.com/form/page/DYkxxSHRRU0FvV3JS" rel="noopener">投稿野史素材</a></p>
    </div>
  </footer>
  <script>
    (function () {
      var btn = document.getElementById('theme-toggle'), root = document.documentElement;
      btn.hidden = false;
      btn.addEventListener('click', function () {
        var dark = root.dataset.theme ? root.dataset.theme === 'dark' : !matchMedia('(prefers-color-scheme: light)').matches;
        root.dataset.theme = dark ? 'light' : 'dark';
        try { localStorage.setItem('theme', root.dataset.theme); } catch (e) {}
      });
      // 计数图响应慢且禁止缓存，等页面加载完再取，免得每次刷新都拖住加载
      var hits = document.getElementById('hits');
      function loadHits() { hits.onload = function () { hits.hidden = false; }; hits.src = hits.dataset.src; }
      // 头像、战徽、字体长期存在读者本地，见 sw.js
      function afterLoad() {
        loadHits();
        if ('serviceWorker' in navigator) navigator.serviceWorker.register('{{ "/sw.js" | url }}').catch(function () {});
      }
      if (document.readyState === 'complete') afterLoad(); else addEventListener('load', afterLoad);
    })();
  </script>
</body>
</html>
