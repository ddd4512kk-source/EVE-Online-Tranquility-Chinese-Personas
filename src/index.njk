---
layout: base.njk
bodyClass: page-index
---
{%- set people = collections.people -%}
<section class="intro">
  <h1>{{ site.title }}</h1>
  <p>{{ site.description }}按主角色创号先后为序，共收 <strong>{{ people.length }}</strong> 人。</p>
</section>

{#- 筛选区沿用军团目录的 .corp-filters 分组行：首行搜索与随机、排序组，次行标签组 -#}
<div class="corp-filters roster-filters" aria-label="列传筛选">
  <div class="corp-filter-row">
    <div class="toolbar corp-toolbar" role="search">
      <input id="filter" type="search" placeholder="筛选：名字、外号、标签…" autocomplete="off" aria-label="按名字或标签筛选">
      <button id="shuffle" type="button" aria-pressed="false" title="随机排序，再点重新洗牌"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 7h3c5 0 7 10 12 10h3M17 13l4 4-4 4M3 17h3c1.5 0 2.7-.9 3.8-2.3M14.2 9.3C15.3 7.9 16.5 7 18 7h3M17 3l4 4-4 4"/></svg><span>随机<span class="shuffle-more">排序</span></span></button>
    </div>
    <div class="corp-filter-group">
      <span class="corp-filter-heading" id="roster-sort-heading">排序</span>
      <div class="tag-wrap">
        <nav class="tag-bar" id="roster-sorts" aria-labelledby="roster-sort-heading">
          <button type="button" class="chip is-active" data-sort="birth" aria-pressed="true" title="按创号时间，老号在前；再点切换">创号 ↑</button>
          <button type="button" class="chip" data-sort="recent" aria-pressed="false" title="按更新时间，最近更新的在前；再点切换">更新 ↓</button>
          {%- for a in radarAxes %}<button type="button" class="chip chip-axis chip-axis-{{ a.key }}" data-sort="{{ a.key }}" aria-pressed="false" title="按{{ a.fullLabel }}由高到低；再点切换由低到高">{{ a.label }} ↓</button>{% endfor %}
        </nav>
      </div>
    </div>
    {#- 阵营筛选默认收起；无 JS 时保持 hidden，全站无阵营时不输出 -#}
    {%- set al = people | alignmentCounts %}
    {%- if al.total %}
    <div class="corp-filter-group align-filter" hidden>
      <span class="corp-filter-heading" id="roster-align-heading">阵营</span>
      <details class="align-dd">
        <summary class="chip" aria-describedby="roster-align-heading"><span id="align-current">全部</span> ▾</summary>
        <div class="align-pick" role="group" aria-labelledby="roster-align-heading">
          <button type="button" class="ap-all is-on" data-al="" data-label="全部" aria-pressed="true">全部<small>{{ al.total }}</small></button>
          {%- for l in al.laws %}<button type="button" class="ap-col" data-al="{{ l.selection }}" data-label="{{ l.label }}" aria-pressed="false" title="{{ l.label }}整列 {{ l.count }} 人">{{ l.label }}</button>{% endfor %}
          {%- for m in al.morals %}
          <button type="button" class="ap-row" data-m="{{ m.key }}" data-al="{{ m.selection }}" data-label="{{ m.label }}" aria-pressed="false" title="{{ m.label }}整行 {{ m.count }} 人">{{ m.label }}</button>
          {%- for c in al.cells %}{% if c.moral == m.key %}<button type="button" class="ap-cell" data-m="{{ c.moral }}" data-al="{{ c.code }}" data-label="{{ c.label }}" aria-pressed="false" title="{{ c.label }} {{ c.count }} 人"{% if not c.count %} disabled{% endif %}>{{ c.short }}<small>{{ c.count }}</small></button>{% endif %}{% endfor %}
          {%- endfor %}
        </div>
      </details>
    </div>
    {%- endif %}
  </div>
  {%- if collections.tagMap.length %}
  <div class="corp-filter-group">
    <span class="corp-filter-heading" id="roster-tag-heading">标签</span>
    <div class="tag-wrap">
      <nav class="tag-bar" id="tag-bar" aria-labelledby="roster-tag-heading">
        <button type="button" class="chip is-active" data-tag="" aria-pressed="true">全部<small>{{ people.length }}</small></button>
        {%- for s in people | statusChips %}<button type="button" class="chip chip-{{ s.kind }}" data-tag="{{ s.name }}" aria-pressed="false">{{ s.name }}<small>{{ s.count }}</small></button>{% endfor %}
        {%- for t in collections.tagMap %}<button type="button" class="chip" data-tag="{{ t.name }}" aria-pressed="false">{{ t.name }}<small>{{ t.items.length }}</small></button>{% endfor %}
      </nav>
      <button type="button" class="tag-more" aria-controls="tag-bar" aria-expanded="false" hidden>展开 ▾</button>
    </div>
  </div>
  {%- endif %}
</div>
<p id="filter-status" class="filter-status" aria-live="polite" hidden></p>

<ol id="roster" class="cards roster">
{%- for p in people %}
  {% include "card.njk" %}
{%- endfor %}
</ol>

<script type="module" src="{{ '/assets/js/roster.js' | url }}?v={{ site.build }}"></script>
