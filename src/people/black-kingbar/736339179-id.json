    "radar": {
      "version": 1,
      "reviewedAt": "2026-11-14T03:25:00Z",
      "verdict": "十四个长门齐进退，自掏腰包补税差，被催债反向打脸盟主‘我欠的是一千六百亿’。",
      "axes": {
        "shenren": {
          "tier": "B",
          "reason": "被追讨联盟税时亲自下场公然叫板‘我欠的我就不交’，反向纠偏‘我欠的是1600亿不是200亿’嘲讽盟主算不清账，自曝式争吵节目效果拉满。",
          "sources": [
            {
              "label": "贴吧长门饭店军团帖",
              "url": "https://tieba.baidu.com/p/8742601380"
            }
          ]
        },
        "combat": {
          "tier": "A",
          "reason": "主号与十四个已确认小号均有实战，多号累计远非旧评语的三千余杀。",
          "sources": [
            {
              "label": "Falkia zKillboard",
              "url": "https://zkillboard.com/character/736339179/"
            }
          ]
        },
        "command": {
          "tier": "C",
          "reason": "实际组织矿队与物流，体现生产协同，不能直接算舰队 FC。",
          "sources": [
            {
              "label": "军团历史与管理记录",
              "url": "https://evewho.com/corporation/98599770"
            }
          ]
        },
        "charisma": {
          "tier": "C",
          "reason": "从一人建团到稳定成员群，支撑团内凝聚力。",
          "sources": [
            {
              "label": "贴吧军团建设说明",
              "url": "https://tieba.baidu.com/p/8742601380"
            }
          ]
        },
        "politics": {
          "tier": "B",
          "reason": "一手将BKB军团从一人扩至上百人，搞矿队、办快递、统筹各部运转，在联盟声望事故与脱离转投中力保本团利益，具备成熟的军团治理手腕。",
          "sources": [
            {
              "label": "联盟税单交涉记录",
              "url": "https://tieba.baidu.com/p/8742601380"
            }
          ]
        },
        "wealth": {
          "tier": "A",
          "reason": "从事超旗制造与第七工业部门实际生产（≥ A），叠加同场 14 开「BKB-长门」战斗小号出战渎圣（B）、7×12 小时满加成矿队、24 小时跨星域跳货物流及自掏腰包补贴税差（B），多项独立依据合评 A（欠税不计入个人资产）。",
          "sources": [
            {
              "label": "Black.King.Bar 军团与战损资料",
