    "radar": {
      "version": 1,
      "reviewedAt": "2026-11-14T07:05:00Z",
      "verdict": "会战是老实打泡泡的打工人，休战是把安全灯拧成血红精算统合部的高安路霸战神刘妥妥。",
      "axes": {
        "shenren": {
          "tier": "C",
          "reason": "他写了一套护身训练，新手教程才刚开课，自己便开便宜护卫扎进大仗；后来又在高安被人收掉。",
          "sources": [
            {
              "label": "LiuTuoTuo DiDi 角色名片与简介",
              "url": "https://zkillboard.com/character/2114568481/"
            }
          ]
        },
        "combat": {
          "tier": "S",
          "reason": "击杀超5100次、消灭超11万亿，高安极速秒杀与00超旗会战全通，挂战神勋章的顶尖杀手。",
          "sources": [
            {
              "label": "LiuTuoTuo DiDi zKillboard",
              "url": "https://zkillboard.com/character/2114568481/"
            }
          ]
        },
        "command": {
          "tier": "C",
          "reason": "专注单兵高安精准强暴与大舰队特种执行，未见独立大舰队带队指挥。",
          "sources": [
            {
              "label": "LiuTuoTuo DiDi 角色档案",
              "url": "https://zkillboard.com/character/2114568481/"
            }
          ]
        },
        "charisma": {
          "tier": "D",
          "reason": "靠多开一人包办整支强暴队，没有团队号召力；吧里骂他的是被他打的苦主，不是他的人缘。",
          "sources": [
            {
              "label": "LiuTuoTuo DiDi zKillboard",
              "url": "https://zkillboard.com/character/2114568481/"
            }
          ]
        },
        "politics": {
          "tier": "D",
          "reason": "不问政事，专注在红灯区收高安过路费与会战打工，常人基准。",
          "sources": [
            {
              "label": "LiuTuoTuo DiDi 雇佣记录",
              "url": "https://zkillboard.com/character/2114568481/"
            }
          ]
        },
        "wealth": {
          "tier": "A",
          "reason": "名下拥有13个确认角色，常年单人十余开强制者级高安强暴大队（大规模多开B）并向工业玩家收取免战保护费，大型会战中亦多开鹏鲲级战列舰同场出勤（C），多开舰队与持续收益相加升A。",
          "sources": [
            {
              "label": "LiuTuoTuo DiDi zKillboard",
              "url": "https://zkillboard.com/character/2114568481/"
            }
          ]
        }
      }
    },
    "alignment": {
      "code": "LN",
      "note": "会战时老实打工，休战时把安全灯拧红，强暴完还按合同收保护费。"
    }
